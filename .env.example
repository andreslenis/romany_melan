# Claves públicas de Wompi (https://panel.wompi.co)
# El ambiente TEST no mueve dinero real: úsalo para desarrollo.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WOMPI_ENV=TEST

# Secreto de integridad para firmar transacciones (Dashboard > Desarrolladores > Secretos)
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxx

# Secreto de eventos para validar webhooks (Dashboard > Mi cuenta > Secretos)
# DISTINTO al secreto de integridad y a las llaves pública/privada.
WOMPI_EVENT_SECRET=test_events_xxxxxxxxxxxxxxxxxxxx

# URL a la que Wompi devuelve al cliente tras el pago (redirect-url).
# Debe coincidir con los dominios permitidos en el panel de Wompi.
NEXT_PUBLIC_WOMPI_REDIRECT_URL=https://romanymelan-ebon.vercel.app/checkout/respuesta

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
